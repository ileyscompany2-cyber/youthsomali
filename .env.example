SITE_ORIGIN=https://your-site.netlify.app
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=replace-me
AUTH0_CLIENT_SECRET=replace-me
# Generate 32 random bytes as 64 hexadecimal characters.
SESSION_SECRET=replace-with-64-hex-characters
# Comma separated Auth0 user IDs, not emails. Verified email is also required.
ADMIN_SUBJECTS=auth0|replace-me
GITHUB_TOKEN=replace-me
GITHUB_OWNER=your-organization
GITHUB_REPO=your-repository
GITHUB_BRANCH=main
