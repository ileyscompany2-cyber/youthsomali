Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteRule ^(php|database|scripts|src|Testimonials|uploads|node_modules|vendor|\.next)(/|$) - [F,L,NC]
    RewriteRule ^\.env(\..*)?$ - [F,L,NC]
    RewriteRule ^\.git(/|$) - [F,L,NC]
    RewriteRule ^(database\.sql|composer\.(json|lock)|router\.php)$ - [F,L,NC]
</IfModule>

<FilesMatch "^\.(env|git)">
    Require all denied
</FilesMatch>

<FilesMatch "\.php$">
    Require all denied
</FilesMatch>

<FilesMatch "\.(?i:sql|md|log|ini|conf|dist|lock)$">
    Require all denied
</FilesMatch>
